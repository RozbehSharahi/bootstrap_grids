# Copy this file to .env and modify as needed

# TYPO3 versions available: 12, 13
# Copies .docker/templates/v${TYPO3}/ on container start.
# composer install has no lockfile, so it picks the newest matching core (TYPO3 13 today).
# For a TYPO3 12 stack, constrain typo3/cms-core to ^12.4 (CI does this per matrix cell).
TYPO3=12

# PHP versions available: 8.2, 8.3, 8.4
PHP=8.4

# Optional temporary workaround: Uncomment the following line to bypass Composer platform check (use when a dependency has not declared support for your PHP version yet, e.g. gridelements on unsupported PHP versions)
#COMPOSER_IGNORE_PLATFORM_REQ=php

#!/bin/bash

set -e

# Shared wrapper used by all .docker/bin helper scripts.
# It ensures .docker/.env exists, exports env vars for compose interpolation,
# prints the selected TYPO3/PHP versions, then forwards all args to
# docker compose with the project's base compose file.
# Usage example from project root:
#   .docker/bin/compose up -d --build
#   .docker/bin/compose exec app bash
source .docker/bin/_common.sh
load_docker_env

echo "
Environment...
  $(if [[ ${TYPO3} ]] ;    then echo 'TYPO3:   ' ${TYPO3}; else echo 'TYPO3: Not set'; fi)
  $(if [[ ${PHP} ]] ;      then echo 'PHP:     ' ${PHP};   else echo 'PHP: Not set'; fi)
"

docker compose -f .docker/docker-compose.base.yml "$@"

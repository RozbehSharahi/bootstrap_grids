#!/usr/bin/env bash

set -e

# Usage example from project root (requires `app` container already running or run `.docker/bin/up` first):
#   .docker/bin/composer --version
#   .docker/bin/composer update
# Optional --ignore-platform-req comes from COMPOSER_IGNORE_PLATFORM_REQ in the
# container env (set from .docker/.env when the app is started).
.docker/bin/compose exec app sh -c 'composer ${COMPOSER_IGNORE_PLATFORM_REQ:+--ignore-platform-req="$COMPOSER_IGNORE_PLATFORM_REQ"} "$@"' sh "$@"
